<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RunConfiguration)' == 'Apsy.Engine.BackEnd.Generator.Boilerpolate' " />
	<ItemGroup>
    <PackageReference Include="AppleReceiptVerifier.NET" Version="1.1.0" />
    <PackageReference Include="Apsy.Common.Api.Auth" Version="4.1.2" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.405.4" />
    <PackageReference Include="AWSSDK.SimpleEmail" Version="3.7.402.2" />
    <PackageReference Include="FirebaseAdmin" Version="2.3.0" />
    <PackageReference Include="GraphQL.Server.Ui.Altair" Version="6.1.0" />
		<PackageReference Include="HotChocolate.Abstractions" Version="13.9.16" />
		<PackageReference Include="HotChocolate.AspNetCore" Version="13.9.16" />
		<PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="13.9.16" />
		<PackageReference Include="HotChocolate.Data" Version="13.9.16" />
		<PackageReference Include="HotChocolate.Types" Version="13.9.16" />
		<PackageReference Include="Mapster" Version="7.4.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.28" />
		<PackageReference Include="Microsoft.IdentityModel.Protocols" Version="8.3.1" />
		<PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.3.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.28" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.28">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.28">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql.NetTopologySuite" Version="8.0.3" />
    <PackageReference Include="SendGrid" Version="9.28.0" />
    <PackageReference Include="Stripe.net" Version="52.0.0" />
    <PackageReference Include="Twilio" Version="7.14.9" />

    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="6.9.0" />
		<PackageReference Include="Aps.CommonBack.Auth" Version="1.2.7" />
		<PackageReference Include="Aps.CommonBack.Base" Version="1.2.7.1" />
    <PackageReference Include="AWSSDK.Translate" Version="3.7.400.32" />
    <PackageReference Include="Google.Apis.AndroidPublisher.v3" Version="1.70.0.3899" />
  </ItemGroup>

	<ItemGroup>
	  <None Remove="Migrations\" />
	  <None Remove="Aps.CommonBack.Auth" />
	  <None Remove="Aps.CommonBack.Base" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="Data\firebase-dev.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Update="Data\firebase-prd.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Update="Data\firebase-qa.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Update="Data\firebase-stg.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Update="googleserviceaccount.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Data\confirm-email.html">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
</Project>
