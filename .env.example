# ----------------------------------------------------------------------------
# TherExNow / HepNow Backend - Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
#
# This is an ASP.NET Core app, so .NET does not load ".env" files natively.
# Two ways to apply these values:
#
#   1) Export them in your shell before running the app, e.g.:
#        export $(grep -v '^#' .env | xargs)
#        dotnet run --project Aps.Apps.HepNow.Api
#
#   2) Use a process manager / Docker "env_file" / systemd "EnvironmentFile"
#      that loads ".env" into the process environment.
#
# ASP.NET Core's configuration system automatically reads environment
# variables and overrides matching keys in appsettings.json. Nested keys use
# a double underscore "__" in place of ":" (e.g. ConnectionStrings__DbConnection
# maps to ConnectionStrings:DbConnection / configuration["ConnectionStrings:DbConnection"]).
# ----------------------------------------------------------------------------


# --- ASP.NET Core host ---------------------------------------------------

# Controls which appsettings.{Environment}.json is loaded and enables
# dev-only behaviors (Swagger, detailed GraphQL errors, etc.)
# Values: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# URL(s) Kestrel listens on. Optional - defaults come from launchSettings.json
# in Development, or 5000/5001 otherwise.
# ASPNETCORE_URLS=http://0.0.0.0:8080


# --- Database (MySQL via Pomelo EF Core provider) -------------------------

# Full ADO.NET connection string for MySQL.
# Format: Server=<host>; port=<port>; Database=<db>; UserId=<user>; Password=<password>;
ConnectionStrings__DbConnection=Server=localhost; port=3306; Database=hepnow; UserId=root; Password=changeme;


# --- Firebase Authentication (used as the JWT issuer/audience) ------------

# Firebase project ID. Used to build the JWT issuer/audience:
# https://securetoken.google.com/{ProjectName}
ProjectName=your-firebase-project-id

# Filename (under Aps.Apps.HepNow.Api/Data/) of the Firebase service-account
# JSON used by FirebaseAppCreator. One of:
#   firebase-dev.json | firebase-qa.json | firebase-stg.json | firebase-prd.json
ProjectJsonUri=firebase-dev.json

# Firebase Web API key, used by AccountController for email/password login
# via Apsy.Common.Api.Auth (Identity Toolkit REST API).
ApiKey=your-firebase-web-api-key


# --- General app config ----------------------------------------------------

# Logical environment name used by app code (NOT the same as
# ASPNETCORE_ENVIRONMENT). "prd" disables detailed GraphQL exception output.
# Values: dev | qa | stg | prd
env=dev

# Public URL of the Terms & Conditions page, substituted into outgoing
# confirmation emails (see UserMutations / Data/confirm-email.html).
TermsAndConditionUrl=https://example.com/terms-of-service/


# --- SendGrid (transactional email) ----------------------------------------

SendGridConfig__ApiKey=SG.your-sendgrid-api-key
SendGridConfig__EmailFrom=noreply@example.com


# --- Twilio (SMS notifications) --------------------------------------------

TwilioConfig__AccountSID=<your-twilio-account-sid>
TwilioConfig__AuthToken=your-twilio-auth-token
TwilioConfig__FromNumber=+10000000000


# --- Stripe (subscription billing & webhooks) ------------------------------

StripeSettings__PublishableKey=<your-stripe-publishable-key>
StripeSettings__Secretkey=<your-stripe-secret-key>
# Used to verify the "Stripe-Signature" header on POST /api/StripeWebhook
StripeSettings__WebhookSecret=<your-stripe-webhook-secret>


# --- Apple (in-app purchase receipt verification & App Store Server webhooks) ---

# Shared secret from App Store Connect, used to verify auto-renewable
# subscription receipts (AppleReceiptVerifier.NET).
AppleSharedSecret=your-apple-shared-secret


# --- AWS Translate (TranslateService) ---------------------------------------

TranslatorConfig__AccessKey=<your-aws-access-key-id>
TranslatorConfig__SecretKey=your-aws-translate-secret-key
TranslatorConfig__Region=us-west-1


# --- AWS S3 (file uploads via UploadController) -----------------------------

S3Credentials__AccessKey=<your-aws-access-key-id>
S3Credentials__SecretKey=your-aws-s3-secret-key
S3Credentials__Region=us-west-1
S3Credentials__BucketName=your-s3-bucket-name
# Public base URL used to build links to uploaded files
S3Credentials__UrlAddress=https://your-s3-bucket-name.s3.us-west-1.amazonaws.com/


# --- AWS SES (account/registration emails via EmailService) -----------------

SES-Credentials__AccessKey=<your-aws-access-key-id>
SES-Credentials__SecretKey=your-aws-ses-secret-key
SES-Credentials__Region=us-west-1
# "From" address used for the post-registration confirmation email
SES-Credentials__SendEmailAfterRegister=noreply@example.com
SES-Credentials__EmailFrom=noreply@example.com
SES-Credentials__SupportEmailCustomer=support@example.com
